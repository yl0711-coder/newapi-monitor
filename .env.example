# newapi-monitor 配置示例
# 复制为 .env 并填写真实值;.env 已被 .gitignore 忽略,切勿提交真实凭证。

# —— 必填 ——
# new-api 库的【只读】DSN(MySQL)。授予 logs/channels/users/tokens 四表 SELECT；
# 聚合切到 facts 后页面不再扫 logs，但同步仍需 logs，资料快照需 users/tokens。
NEWAPI_LOG_DSN=ro_user:pass@tcp(db-host:3306)/newapi?charset=utf8mb4&timeout=5s&readTimeout=10s
# new-api 地址,用于登录鉴权(调用其 /api/user/login)
MONITOR_NEWAPI_BASE_URL=https://your-newapi.example.com
# 会话签名密钥:openssl rand -hex 32
MONITOR_SESSION_SECRET=
# 渠道管理中的上游访问令牌加密密钥；生产建议与会话密钥分离并长期固定。
# 留空时仅可回退到显式配置的 MONITOR_SESSION_SECRET；两者都留空会拒绝保存上游凭据。
MONITOR_UPSTREAM_CREDENTIAL_SECRET=
# —— 可选(含默认值)——
MONITOR_ADDR=:8090
MONITOR_STORE_PATH=/data/monitor.db
# 高增长的用量事实独立存放；留空时自动使用 <主库目录>/usage-facts.db。
MONITOR_USAGE_FACTS_STORE_PATH=/data/usage-facts.db
# Monitor 自有 SQLite 启动前会执行 quick_check；运行中每天创建一份经过
# quick_check 的一致性备份；主库和事实库分别生成 monitor-* / usage-facts-*。
# 备份与两份运行库必须放持久化卷，不能放容器可写层。
MONITOR_STORE_BACKUP_ENABLED=true
# 在线/迁移快照必须落独立持久卷；仍需再复制到实例外加密存储。
MONITOR_STORE_BACKUP_DIR=/backup
MONITOR_STORE_BACKUP_INTERVAL_HOURS=24
MONITOR_STORE_BACKUP_RETENTION=7
MONITOR_STORE_MIGRATION_BACKUP_RETENTION=3
# MySQL 短暂不可达时仍从 SQLite 服务已发布数据；后台自动恢复。
# 生产保持 lease=true，防止滚动升级/双实例重复采集和轮询上游。
MONITOR_SOURCE_WORKER_ENABLED=true
MONITOR_SOURCE_LEASE_REQUIRED=true
MONITOR_SOURCE_LEASE_NAME=newapi-monitor-source-worker-v1
MONITOR_SAMPLE_SECONDS=60
MONITOR_RETENTION_DAYS=7
MONITOR_HOUR_RETENTION_DAYS=90
# 来源 epoch 重建时只补本地水位后的缺口，代码硬限最多 1 小时；更久历史只走受控维护任务。
MONITOR_BACKFILL_HOURS=1
# 上游账户余额成功同步间隔与单次请求超时；失败会指数退避。
MONITOR_UPSTREAM_SYNC_ENABLED=true
MONITOR_UPSTREAM_SYNC_MINUTES=5
MONITOR_UPSTREAM_SYNC_TIMEOUT_SECONDS=15
# 上游消费账单独立于余额同步；支持 NewAPI、Sub2API 和 AICodeWith，
# 只有在对应账户中显式启用后才会低频同步；同主机始终串行，跨主机并发硬上限 2。
# 新的上游消费日志同步独立灰度开关；首次发布保持 false，线上观察后再显式开启
MONITOR_UPSTREAM_USAGE_SYNC_ENABLED=false
MONITOR_UPSTREAM_USAGE_SYNC_MINUTES=20
MONITOR_UPSTREAM_MAX_CONCURRENCY=1
MONITOR_UPSTREAM_USAGE_BACKFILL_DAYS=90
# 多中转站计价证据账本是独立影子链路；支持 NewAPI、Sub2API 和 AICodeWith，首次发布必须保持关闭。
# 上线后按账户逐个加入白名单验收，不要一次全开。
MONITOR_UPSTREAM_PRICING_LEDGER_ENABLED=false
MONITOR_UPSTREAM_PRICING_LEDGER_DOMAINS=
MONITOR_UPSTREAM_PRICING_BACKFILL_HOURS_PER_RUN=1

# Compose 镜像必须是完成本地验收的不可变版本标签或 digest，禁止 latest。
MONITOR_IMAGE=ghcr.io/yl0711-coder/newapi-monitor:REPLACE_WITH_ACCEPTED_TAG_OR_DIGEST

# 生产固定 fail-closed：聚合页面只读已发布 facts。首次补全期间页面显示
# 已发布的较短窗口或“补全中”，不会静默回扫来源 logs。
MONITOR_USAGE_FACTS_ENABLED=true
MONITOR_USAGE_FACTS_READ_ENABLED=true
# 生产全历史模式必须由 DBA 确认 hot logs 自每个 active 用户注册日起无归档缺口。
# SOURCE_EPOCH 是这份来源契约的稳定标识；归档、路由或可见性变化必须换值并全域重签。
MONITOR_USAGE_FACTS_FULL_HISTORY_ENABLED=true
MONITOR_USAGE_FACTS_HISTORY_SOURCE_MODE=complete
MONITOR_USAGE_FACTS_HISTORY_SOURCE_EPOCH=REPLACE_WITH_DBA_SIGNED_SOURCE_EPOCH
MONITOR_USAGE_FACTS_HISTORY_DELAY_MS=30000
MONITOR_USAGE_FACTS_HISTORY_SOURCE_DUTY_PERCENT=20
MONITOR_USAGE_FACTS_HISTORY_MAX_DISK_USED_PERCENT=80
MONITOR_USAGE_FACTS_HISTORY_MIN_FREE_BYTES=2147483648
# 生产默认使用有界原始日志分页并在SQLite聚合；false只用于紧急兼容回退。
MONITOR_USAGE_FACTS_RAW_PAGE_IMPORT_ENABLED=true
# 口径迁移只在独立维护阶段设 true，且同阶段 READ_ENABLED 必须为 false。
MONITOR_USAGE_FACTS_CLASSIFICATION_MIGRATION_ENABLED=false
# 仅供尚未切换全历史的有限窗口兼容路径；全历史起点不读取该值。
MONITOR_USAGE_FACTS_BACKFILL_DAYS=90
MONITOR_USAGE_FACTS_RETENTION_DAYS=400
MONITOR_USAGE_FACTS_HOUR_RETENTION_DAYS=8
MONITOR_USAGE_FACTS_SYNC_MINUTES=5
MONITOR_USAGE_FACTS_PROFILE_SYNC_MINUTES=5
MONITOR_USAGE_FACTS_BACKFILL_DELAY_MS=15000
MONITOR_USAGE_FACTS_QUERY_TIMEOUT_SECONDS=20
MONITOR_USAGE_FACTS_LAG_MINUTES=10
MONITOR_USAGE_FACTS_RECONCILE_MINUTES=30

# 历史稳定性报表（只读生产 logs，长期数据写入 Monitor 自己的 SQLite）。
MONITOR_STABILITY_ENABLED=true
MONITOR_STABILITY_QUERY_MAX_DAYS=90
# 至少应为 2×QUERY_MAX+1，才能同时保留当前周期和上一对比周期。
MONITOR_STABILITY_RETENTION_DAYS=181
MONITOR_STABILITY_PROBLEM_SAMPLE_SECONDS=300
# 所有后台来源查询（采样、facts、稳定性）共用最小启动间隔与单并发闸门。
MONITOR_BACKGROUND_SOURCE_MIN_START_INTERVAL_MS=2000
MONITOR_STABILITY_BACKFILL_DELAY_MS=2000
MONITOR_STABILITY_BACKFILL_TIMEOUT_SECONDS=20
# MySQL 服务端硬停止单条 range/control SELECT；即使客户端超时更大也不允许超过 8 秒。
MONITOR_STABILITY_BACKFILL_SERVER_MAX_EXECUTION_MS=8000
MONITOR_STABILITY_BACKFILL_SOURCE_DUTY_PERCENT=20
# 关闭后同时禁止人工补数、自动修洞和重启续跑；本地验收应设为 false。
MONITOR_STABILITY_BACKFILL_ENABLED=true
MONITOR_STABILITY_AUTO_REPAIR=true
# 分类版本升级的大范围迁移必须由运维显式开启；默认 false，普通启动绝不
# 自动扫描全部留存历史。任务创建后持久化，可在进程重启后继续。
MONITOR_STABILITY_CLASSIFICATION_MIGRATION_ENABLED=false

# Compose 使用预创建的独立 external volumes，避免项目名变化时静默挂载空卷。
MONITOR_DATA_VOLUME=newapi-monitor-data
MONITOR_BACKUP_VOLUME=newapi-monitor-backup

# Nginx 入口层旁路聚合（默认关闭）。只在采集器和专用脱敏日志均部署完成后开启。
MONITOR_NGINX_ENABLED=false
MONITOR_NGINX_RETENTION_DAYS=7
# 启用时必填；未列入白名单的节点即使持有共享采集令牌也会被拒绝。
MONITOR_NGINX_ALLOWED_NODES=

# 客户用量聚合结果 Redis 缓存（可选；留空地址即关闭，页面会自动使用有界本机短缓存）。
# 生产只填 Redis 私网地址，并为 Monitor 建立仅能访问 nxmon:* 的独立 ACL 用户。
MONITOR_USAGE_REDIS_ADDR=
MONITOR_USAGE_REDIS_USERNAME=
MONITOR_USAGE_REDIS_PASSWORD=
MONITOR_USAGE_REDIS_DB=0
MONITOR_USAGE_REDIS_PREFIX=nxmon:usage:v1
