# Token 独立采集与检测配置模板。由发布者合并到正式服务的环境变量，
# 不能替换整份线上环境；不改变 Usage、来源租约、共享查询预算或其他采集开关。
# 开关保持关闭；完成 8204 验证并取得正式启用授权后再同时开启。
MONITOR_TOKEN_FACTS_ENABLED=false
MONITOR_TOKEN_DETECTION_ENABLED=false

# 必填：实际生产 logs 来源的稳定标识；来源改变才换 epoch，不按部署换名。
# 只在确认来源包含指定范围全部记录后，将 unverified 改为 complete。
MONITOR_TOKEN_FACTS_SOURCE_EPOCH=
MONITOR_TOKEN_FACTS_SOURCE_MODE=unverified
MONITOR_TOKEN_FACTS_INITIAL_LOOKBACK_SECONDS=900
MONITOR_TOKEN_FACTS_RETENTION_DAYS=4
# 挂载独立持久卷，UID 1000 可写；不得与主库/Usage/Nginx 证据库共用 SQLite 文件。
MONITOR_TOKEN_STORE_PATH=/token-data/token.db
MONITOR_TOKEN_FACTS_MAX_ROWS=2000000
MONITOR_TOKEN_FACTS_MAX_BYTES=17179869184
MONITOR_TOKEN_DETECTION_MAX_ROWS=2000000
MONITOR_TOKEN_DETECTION_MAX_BYTES=25769803776
MONITOR_TOKEN_DETECTION_MAX_REFERENCES=20000
MONITOR_TOKEN_DETECTION_MAX_REFERENCE_RECORDS=200000
MONITOR_TOKEN_DETECTION_RETENTION_DAYS=4
MONITOR_TOKEN_DETECTION_RETENTION_BASIS=first_evaluated
MONITOR_TOKEN_STORE_MIN_FREE_BYTES=8589934592
MONITOR_TOKEN_STORE_MAX_USED_PERCENT=90
MONITOR_TOKEN_PROCESSING_POLL_SECONDS=15
MONITOR_TOKEN_PROCESSING_BATCH_ROWS=250
MONITOR_TOKEN_DETECTION_WORKERS=1
MONITOR_TOKEN_DETECTION_WORK_MS=250
MONITOR_TOKEN_DETECTION_COMMIT_ROWS=16

# 适配器名称本身不能证明结算口径。source_contract 必须绑定实际生产 epoch、
# 有效起止时间及版本/源码核验凭据后再配置；空契约不会补零或伪造历史价格。
MONITOR_TOKEN_FACTS_USAGE_ADAPTER=unknown
MONITOR_TOKEN_FACTS_SEMANTIC_BINDINGS=
MONITOR_TOKEN_DETECTION_POLICY={"version":"production-text-comparable-v1","min_samples":3,"min_channels":2,"lookback_seconds":3600,"size_tolerance_bytes":64,"size_relative_tolerance":"0.01","input_ratio":"5","min_input":20000,"cache_share_drop":"0.5","cache_intensity_ratio":"2","cache_min_sustained":3,"pricing_adapter":"newapi-text-v1"}

# 必需的入口证据沿用线上已有 Nginx/CloudWatch 采集方式，并核验 request_id、
# request_length、路径、方法、节点和事件时间。专用 HMAC key_id/key 在密钥系统配置，
# 不使用会话密钥；Token 与入口证据必须使用兼容的版本化 HMAC。
# 当前线上 CloudWatch Nginx 连续采集未开启：未经入口字段和查询预算验收不得顺带开启。
# 缺入口证据时，仅独立执行字段一致性/已证实的历史公式规则；关联/统计规则如实缺证。

# 容量是载荷上限，不是 SQLite 文件上限。按留存实测预留至少 80 GiB 可用持久空间
# 给 Token 文件、索引、WAL、证据及增长；独立备份空间另计，始终保留至少 8 GiB。
# 单个检测 worker 起步，CPU/内存沿用服务现有预算，验证正常查询及最新窗口后再调整。
# 过期事实只有在备份、限定范围对账、引用索引就绪且终态成立时才可回收；
# 不删除未完成事实/重试/必要证据。容量上调只能解除当前阻断，不能代替安全回收。
# 回退：关闭以上两个 Token 开关并保留卷/游标；不回滚或删除业务数据。
